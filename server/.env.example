# ===== MHFac - variables d'environnement (copier vers server/.env) =====
NODE_ENV=development
PORT=4000
# URL du client autorisee par CORS (plusieurs : separees par des virgules)
CLIENT_URL=http://localhost:5173

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mhfac
DB_PASSWORD=change_me
DB_NAME=mhfac

# --- Secrets JWT (min. 32 caracteres, a generer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- E-mails transactionnels (Phase 3) ---
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MHFac <no-reply@example.com>"

# --- Facturation electronique : "simulation" tant qu'aucun acces officiel (Phase 8) ---
EINVOICE_PROVIDER=simulation
EINVOICE_MODULE=off          # facturation électronique : « bientôt disponible » (laisser off)

# --- Scan de factures fournisseur : lecture LOCALE et GRATUITE (aucune cle, aucun service externe) ---
SCAN_MAX_MB=8              # taille max d'un document scanne
SCAN_HOURLY_LIMIT=30       # scans par heure et par entreprise (maitrise des couts)

# --- Authentification (Phase 3) ---
API_RATE_LIMIT_PER_MIN=300  # requetes par minute et par IP (toute l'API)
AUTH_RATE_LIMIT_MAX=20      # tentatives /auth par IP et par 15 min
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=12
REFRESH_REUSE_GRACE_SECONDS=10   # tolere deux refresh simultanes (onglets) avant de traiter un rejeu comme un vol

# --- Factures recurrentes : generation automatique des BROUILLONS (toutes les heures) ---
RECURRING_SCHEDULER=on   # off pour desactiver (ex. instance secondaire)

# --- Abonnements SaaS (Phase 9) ---
DEFAULT_PLAN_CODE=pro   # plan attribue a chaque nouvelle entreprise (code d'une offre de la table subscription_plans)
TRIAL_REMINDER_DAY=12   # jour de l'essai ou le rappel e-mail (fin d'essai + paiement) est envoye au proprietaire
PLATFORM_ALERT_EMAIL=     # votre e-mail : vous etes prevenu a chaque declaration de virement d'un client (vide = e-mail de contact des coordonnees bancaires)
TRIAL_DAYS=14           # jours d'essai gratuit a l'inscription (0 = aucun) ; a la fin, lecture seule jusqu'a activation par l'administrateur

# --- Hébergement distribué (Vercel + Render + TiDB Cloud) : voir docs/DEPLOIEMENT-CLOUD.md ---
DB_SSL=false          # true pour une base managée (connexion chiffrée obligatoire chez TiDB Cloud)
DB_SSL_CA=            # certificat CA de l'hébergeur (texte PEM, retours à la ligne écrits \n) ; vide = autorités système
TRUST_PROXY=1         # 1 = un proxy devant l'API (Caddy/Nginx) ; 2 = Vercel + Render
DB_POOL_SIZE=15       # connexions MySQL simultanées (15 suffisent pour ~12 entreprises)
