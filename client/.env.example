# Dev : laisser VITE_API_URL vide (le proxy Vite relaie /api vers le serveur)
VITE_API_URL=
VITE_API_PROXY=http://localhost:4000

# Référencement (SEO) : adresse publique du site SANS « / » final, ex. https://facture.exemple.tn
# Sert aux balises canonical / Open Graph, au sitemap.xml et au robots.txt. À renseigner en production (Vercel : Settings > Environment Variables).
VITE_SITE_URL=
